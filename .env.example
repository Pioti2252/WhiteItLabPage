# Copy to .env on the server:  cp .env.example .env && chmod 600 .env
# The SMTP password is NOT here — it goes to ./secrets/smtp_pass (Docker secret).

# --- host port ---------------------------------------------------------------
# Port on 127.0.0.1 where nginx reaches the container. Change it if 8080 is
# already used by another container (check: ss -ltnp | grep :8080).
# scripts/nginx-install.sh reads this value and writes it into the nginx upstream.
WEB_PORT=8080

# --- origin / proxy --------------------------------------------------------
# Browser Origin values allowed to POST the contact form (comma-separated)
ALLOWED_ORIGINS=https://whiteitlab.pl,https://www.whiteitlab.pl
# 1 = trust X-Real-IP from nginx (container is only reachable via nginx)
TRUST_PROXY=1

# 0 = contact API refuses submissions (503). Pair with "contactFormEnabled": false
# in site/config.json, which renders the form as disabled on the page.
CONTACT_ENABLED=1

# --- mail ------------------------------------------------------------------
SMTP_HOST=smtp.example.com
# 587 + SMTP_SECURE=false -> STARTTLS (required). 465 + SMTP_SECURE=true -> implicit TLS.
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=formularz@whiteitlab.pl
# Sender must be on your domain (SPF/DKIM), otherwise mail lands in spam.
MAIL_FROM="whiteitlab <formularz@whiteitlab.pl>"
# Where inquiries are delivered
MAIL_TO=kontakt@whiteitlab.pl
# 1 = don't send, only log metadata (local dev)
MAIL_DRY_RUN=0

# --- limits (defaults shown) ----------------------------------------------
# RATE_LIMIT_PER_IP=5
# RATE_LIMIT_WINDOW_MIN=15
# RATE_LIMIT_GLOBAL_PER_HOUR=60
# MAX_BODY_BYTES=16384
